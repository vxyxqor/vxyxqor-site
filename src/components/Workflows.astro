---
import { workflows, tools } from "../data/tools";
---

<section class="bg-slate-950 py-16 text-white">
  <div class="mx-auto max-w-6xl px-6">
    <div class="mb-10">
      <h2 class="text-2xl font-bold sm:text-3xl">🏗️ AI Workflows</h2>
      <p class="mt-1 text-slate-400">End-to-end sequences that solve real tasks.</p>
    </div>
    <div class="grid gap-5 lg:grid-cols-3">
      {workflows.map(wf => {
        const wfTools = wf.tools.map(id => tools.find(t => t.id === id));
        return (
          <a href={`/workflows/${wf.slug}`} class="group flex flex-col rounded-2xl border border-slate-800 bg-slate-900/60 p-6 transition hover:border-slate-600 hover:bg-slate-800/60">
            <h3 class="mb-2 text-lg font-bold text-white">{wf.title}</h3>
            <p class="mb-5 flex-1 text-sm leading-relaxed text-slate-400">{wf.description}</p>
            <div class="mb-5">
              <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-slate-500">Tools in this workflow</p>
              <div class="flex flex-wrap gap-2">
                {wfTools.map(t => (
                  <span class="inline-flex items-center gap-1.5 rounded-full border border-slate-700 bg-slate-800 px-3 py-1 text-xs font-medium text-slate-300"><span class="h-1.5 w-1.5 rounded-full bg-indigo-400"></span>{t.name}</span>
                ))}
              </div>
            </div>
            <span class="text-sm font-medium text-indigo-400 group-hover:text-indigo-300">See the full workflow →</span>
          </a>
        );
      })}
    </div>
  </div>
</section>
