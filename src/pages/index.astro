---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.tsx";
import TrendingTools from "../components/TrendingTools.tsx";
import Comparisons from "../components/Comparisons.tsx";
import Workflows from "../components/Workflows.tsx";
import Footer from "../components/Footer.tsx";

const title = "vxyxqor — Find the Right AI for the Job";
const description = "Independent AI tool reviews, honest comparisons, and ready-to-use workflows. No fluff. No hype. Just what works.";
---

<Layout title={title} description={description}>
  <Hero client:load />
  <TrendingTools client:visible />
  <Comparisons client:visible />
  <Workflows client:visible />
  <Footer />
</Layout>
