---
import Layout from "../layouts/Layout.astro";

const title = "Affiliate Disclosure — vxyxqor";
const description = "vxyxqor earns commissions through affiliate links. This does not affect our reviews or recommendations.";
---

<Layout title={title} description={description}>
  <main class="mx-auto max-w-3xl px-6 py-20 text-white">
    <h1 class="mb-6 text-3xl font-bold">Affiliate Disclosure</h1>
    <div class="space-y-4 text-slate-300 leading-relaxed">
      <p>vxyxqor participates in affiliate programs for the AI tools we review. This means we earn a commission when you click a link on our site and make a purchase or sign up for a free trial.</p>
      <p>This does not cost you anything extra. The price you pay is exactly the same whether you use our link or go directly to the vendor's website.</p>
      <p>Our reviews are independent. We test every tool hands-on, and our ratings and criticisms are based on real usage — not on commission rates. If a tool is bad, we say so, even if it has an affiliate program.</p>
      <p>If you have questions about our relationships with vendors, contact us at hello@vxyxqor.com.</p>
    </div>
  </main>
</Layout>
